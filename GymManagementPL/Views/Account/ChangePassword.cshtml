@model ChangePasswordViewModel
@{ ViewData["Title"] = "Change password"; }

<div class="page-header"><div><h1>Change password</h1><p class="lead">Use at least 8 characters with upper- and lower-case letters, a number and a symbol.</p></div></div>

<div class="card form-narrow"><div class="card-body">
    <form asp-action="ChangePassword" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
        <div class="mb-3"><label asp-for="CurrentPassword" class="form-label"></label><input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" /><span asp-validation-for="CurrentPassword"></span></div>
        <div class="mb-3"><label asp-for="NewPassword" class="form-label"></label><input asp-for="NewPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="NewPassword"></span></div>
        <div class="mb-4"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span></div>
        <button type="submit" class="btn btn-primary">Update password</button>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary ms-1">Cancel</a>
    </form>
</div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
