@model ErrorViewModel
@{
    ViewData["Title"] = Model.StatusCode == 404 ? "Page not found" : $"Error {Model.StatusCode}";
    Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : "_AuthLayout";
    var message = Model.StatusCode switch
    {
        404 => "We couldn't find what you were looking for. It may have been deleted or the link is wrong.",
        403 => "You don't have permission to view this page.",
        429 => "Too many requests. Please wait a moment and try again.",
        _ => "The request couldn't be completed."
    };
}
<div class="@(User.Identity?.IsAuthenticated == true ? "" : "auth-panel")">
    <div class="empty card p-5 mx-auto" style="max-width:520px">
        <i class="bi bi-compass"></i>
        <h1 class="h4">@(Model.StatusCode == 404 ? "Page not found" : $"Error {Model.StatusCode}")</h1>
        <p>@message</p>
        <div><a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to dashboard</a></div>
    </div>
</div>
