@model MemberToUpdateViewModel
@{ ViewData["Title"] = "Edit member"; }

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Members</a></li><li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id">@Model.Name</a></li><li class="breadcrumb-item active">Edit</li></ol></nav>
        <h1>Edit member</h1>
    </div>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" novalidate>
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Photo" />
    <div class="card form-narrow"><div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

        <div class="d-flex gap-3 align-items-center mb-3">
            <partial name="_Avatar" model='new AvatarModel(Model.Name, Model.Photo is null ? null : Url.Action("Picture", "Member", new { id = Model.Id }), "lg")' />
            <div class="flex-grow-1">
                <label asp-for="PhotoFile" class="form-label"></label>
                <input asp-for="PhotoFile" type="file" class="form-control" accept="image/jpeg,image/png" />
                <span asp-validation-for="PhotoFile"></span>
            </div>
        </div>
        <div class="row g-3">
            <div class="col-md-12"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name"></span></div>
            <div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" type="email" class="form-control" /><span asp-validation-for="Email"></span></div>
            <div class="col-md-6"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" type="tel" inputmode="numeric" maxlength="11" class="form-control" /><span asp-validation-for="Phone"></span></div>
            <div class="col-md-3"><label asp-for="BuildingNumber" class="form-label"></label><input asp-for="BuildingNumber" type="number" min="1" class="form-control" /><span asp-validation-for="BuildingNumber"></span></div>
            <div class="col-md-5"><label asp-for="Street" class="form-label"></label><input asp-for="Street" class="form-control" /><span asp-validation-for="Street"></span></div>
            <div class="col-md-4"><label asp-for="City" class="form-label"></label><input asp-for="City" class="form-control" /><span asp-validation-for="City"></span></div>
        </div>
    </div>
    <div class="card-footer bg-transparent p-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
    </div></div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
