@model HealthRecordViewModel
@{ ViewData["Title"] = "Health record"; }

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Members</a></li><li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.MemberId">@Model.MemberName</a></li><li class="breadcrumb-item active">Health record</li></ol></nav>
        <h1>Health record</h1><p class="lead">@Model.MemberName</p>
    </div>
</div>

<form asp-action="HealthRecord" asp-route-id="@Model.MemberId" method="post" novalidate>
    <div class="card form-narrow"><div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
        <div class="row g-3">
            <div class="col-md-4"><label asp-for="Height" class="form-label"></label><input asp-for="Height" type="number" step="0.1" class="form-control" /><span asp-validation-for="Height"></span></div>
            <div class="col-md-4"><label asp-for="Weight" class="form-label"></label><input asp-for="Weight" type="number" step="0.1" class="form-control" /><span asp-validation-for="Weight"></span></div>
            <div class="col-md-4"><label asp-for="BloodType" class="form-label"></label>
                <select asp-for="BloodType" class="form-select"><option value="">Select…</option>@foreach (var b in new[] { "A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-" }) { <option value="@b" selected="@(Model.BloodType == b)">@b</option> }</select>
                <span asp-validation-for="BloodType"></span></div>
            <div class="col-12"><label asp-for="Note" class="form-label"></label><textarea asp-for="Note" rows="3" class="form-control"></textarea><span asp-validation-for="Note"></span></div>
        </div>
    </div>
    <div class="card-footer bg-transparent p-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Save health record</button>
        <a asp-action="Details" asp-route-id="@Model.MemberId" class="btn btn-outline-secondary">Cancel</a>
    </div></div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
