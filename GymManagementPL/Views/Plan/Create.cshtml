@model CreatePlanViewModel
@{ ViewData["Title"] = "New plan"; }
<div class="page-header"><div>
    <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Plans</a></li><li class="breadcrumb-item active">Create</li></ol></nav>
    <h1>New plan</h1></div></div>
<form asp-action="Create" method="post" novalidate>
    
    <div class="card form-narrow"><div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
        <div class="row g-3">
            <div class="col-12"><label asp-for="PlanName" class="form-label"></label><input asp-for="PlanName" class="form-control" /><span asp-validation-for="PlanName"></span></div>
            <div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" rows="2" class="form-control"></textarea><span asp-validation-for="Description"></span></div>
            <div class="col-md-6"><label asp-for="DurationDays" class="form-label"></label><input asp-for="DurationDays" type="number" min="1" max="365" class="form-control" /><span asp-validation-for="DurationDays"></span></div>
            <div class="col-md-6"><label asp-for="Price" class="form-label"></label><input asp-for="Price" type="number" min="0.01" step="0.01" class="form-control" /><span asp-validation-for="Price"></span></div>
        </div>
    </div>
    <div class="card-footer bg-transparent p-3 d-flex gap-2"><button type="submit" class="btn btn-primary">Create plan</button><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
