@model IReadOnlyList<PlanViewModel>
@{ ViewData["Title"] = "Plans"; var isSuper = User.IsInRole(RoleNames.SuperAdmin); }
<div class="page-header">
    <div><h1>Plans</h1><p class="lead">What members can buy.</p></div>
    @if (isSuper) { <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> New plan</a> }
</div>

@if (Model.Count == 0) { <div class="card"><div class="empty"><i class="bi bi-tags"></i><h3>No plans yet</h3></div></div> }
else
{
    <div class="row g-3">
    @foreach (var p in Model)
    {
        <div class="col-md-6 col-xl-4">
            <div class="card plan-card @(p.IsActive ? "" : "inactive")">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h2 class="h5 mb-0">@p.Name</h2>
                    @if (p.IsActive) { <span class="status status-active">Active</span> } else { <span class="status status-expired">Inactive</span> }
                </div>
                <div class="plan-price tabular">@p.Price.ToString("N0") <small>EGP / @p.DurationDays days</small></div>
                <p class="text-muted my-3 flex-grow-1">@p.Description</p>
                <div class="small text-muted mb-3"><i class="bi bi-people"></i> @p.ActiveMembers active @(p.ActiveMembers == 1 ? "member" : "members")</div>
                @if (isSuper)
                {
                    <div class="d-flex gap-2">
                        @if (p.IsActive && p.ActiveMembers == 0) { <a class="btn btn-soft flex-grow-1" asp-action="Edit" asp-route-id="@p.Id"><i class="bi bi-pencil"></i> Edit</a> }
                        <form asp-action="Activate" asp-route-id="@p.Id" method="post" class="flex-grow-1">
                            <button type="submit" class="btn @(p.IsActive ? "btn-outline-secondary" : "btn-outline-primary") w-100" data-no-loading @(p.IsActive && p.ActiveMembers > 0 ? "disabled" : null)>@(p.IsActive ? "Deactivate" : "Activate")</button>
                        </form>
                    </div>
                }
            </div>
        </div>
    }
    </div>
}
