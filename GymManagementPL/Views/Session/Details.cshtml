@model SessionViewModel
@{ ViewData["Title"] = $"{Model.CategoryName} session"; }
<div class="page-header">
    <div>
        <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Sessions</a></li><li class="breadcrumb-item active">Details</li></ol></nav>
        <h1>@Model.CategoryName</h1><p class="lead">@Model.Description</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-primary" asp-controller="Booking" asp-action="Roster" asp-route-id="@Model.Id"><i class="bi bi-people"></i> Roster</a>
        @if (Model.Status == SessionStatus.Upcoming && Model.BookedCount == 0) { <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id"><i class="bi bi-pencil"></i> Edit</a> }
    </div>
</div>
<div class="card form-narrow"><div class="card-body"><dl class="kv">
    <dt>Status</dt><dd><partial name="_StatusBadge" model="Model.Status" /></dd>
    <dt>Trainer</dt><dd>@Model.TrainerName</dd>
    <dt>Starts</dt><dd>@Model.StartDate.ToString("dddd, d MMM yyyy · h:mm tt")</dd>
    <dt>Ends</dt><dd>@Model.EndDate.ToString("dddd, d MMM yyyy · h:mm tt")</dd>
    <dt>Duration</dt><dd>@Model.DurationDisplay</dd>
    <dt>Capacity</dt><dd class="tabular">@Model.BookedCount booked of @Model.Capacity (@Model.AvailableSlots free)</dd>
</dl></div></div>
