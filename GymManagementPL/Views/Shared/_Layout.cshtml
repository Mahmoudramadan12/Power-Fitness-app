@inject IOptions<GymOptions> Gym
@inject TimeProvider Clock
@{
    var controller = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "").ToLowerInvariant();
    string Active(params string[] names) => names.Contains(controller) ? "active" : "";
    string AriaCurrent(params string[] names) => names.Contains(controller) ? "page" : null!;
    var isSuper = User.IsInRole(RoleNames.SuperAdmin);
    var displayName = User.Identity?.Name ?? "User";
    var role = isSuper ? "Super admin" : "Admin";
    var title = ViewData["Title"] as string;
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(string.IsNullOrEmpty(title) ? Gym.Value.Name : $"{title} · {Gym.Value.Name}")</title>
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <script src="~/js/theme-init.js"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>

    <aside class="sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="sidebar" aria-label="Main navigation">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <span class="brand-mark"><i class="bi bi-lightning-charge-fill"></i></span>
            <span>@Gym.Value.Name</span>
        </a>

        <nav class="d-flex flex-column gap-1 flex-grow-1 overflow-auto">
            <a class="side-link @Active("home")" asp-controller="Home" asp-action="Index" aria-current="@AriaCurrent("home")"><i class="bi bi-grid-1x2-fill"></i> Dashboard</a>

            <div class="nav-section">Training</div>
            <a class="side-link @Active("session")" asp-controller="Session" asp-action="Index" aria-current="@AriaCurrent("session")"><i class="bi bi-calendar-event-fill"></i> Sessions</a>
            <a class="side-link @Active("booking")" asp-controller="Booking" asp-action="Index" aria-current="@AriaCurrent("booking")"><i class="bi bi-journal-check"></i> Bookings</a>

            <div class="nav-section">Business</div>
            <a class="side-link @Active("membership")" asp-controller="Membership" asp-action="Index" aria-current="@AriaCurrent("membership")"><i class="bi bi-card-checklist"></i> Memberships</a>
            <a class="side-link @Active("plan")" asp-controller="Plan" asp-action="Index" aria-current="@AriaCurrent("plan")"><i class="bi bi-tags-fill"></i> Plans</a>

            @if (isSuper)
            {
                <div class="nav-section">People</div>
                <a class="side-link @Active("member")" asp-controller="Member" asp-action="Index" aria-current="@AriaCurrent("member")"><i class="bi bi-people-fill"></i> Members</a>
                <a class="side-link @Active("trainer")" asp-controller="Trainer" asp-action="Index" aria-current="@AriaCurrent("trainer")"><i class="bi bi-award-fill"></i> Trainers</a>
            }
        </nav>

        <div class="sidebar-foot">
            <div class="user-chip">
                <partial name="_Avatar" model='new AvatarModel(displayName, null, "sm")' />
                <div class="text-truncate"><span class="text-truncate d-block">@displayName</span><small>@role</small></div>
            </div>
            <div class="d-flex gap-2 mt-2 px-1">
                <a class="btn btn-sm btn-outline-secondary flex-grow-1" asp-controller="Account" asp-action="ChangePassword" title="Change password"><i class="bi bi-key"></i> Password</a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="flex-grow-1">
                    <button type="submit" class="btn btn-sm btn-outline-secondary w-100" data-no-loading><i class="bi bi-box-arrow-right"></i> Sign out</button>
                </form>
            </div>
        </div>
    </aside>

    <div class="app-main">
        <header class="topbar d-flex align-items-center gap-2">
            <button class="btn btn-icon btn-outline-secondary d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-controls="sidebar" aria-label="Open menu"><i class="bi bi-list fs-5"></i></button>
            <span class="fw-semibold d-lg-none">@Gym.Value.Name</span>
            <div class="ms-auto d-flex align-items-center gap-2">
                <span class="text-muted small d-none d-md-inline">@Clock.GetLocalNow().ToString("dddd, d MMMM")</span>
                <button type="button" class="btn btn-icon btn-outline-secondary" data-theme-toggle aria-label="Toggle dark mode" title="Toggle dark mode"><i class="bi bi-circle-half"></i></button>
            </div>
        </header>

        <main id="main" class="content mx-auto">
            @RenderBody()
        </main>
    </div>

    <partial name="_Notifications" />

    <div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body p-4">
                    <h2 class="h5 mb-2" id="confirmTitle" data-confirm-title>Are you sure?</h2>
                    <p class="text-muted mb-4" data-confirm-body></p>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-danger" data-confirm-ok>Confirm</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @if (IsSectionDefined("Charts"))
    {
        IgnoreSection("Charts");
        <script src="~/lib/chartjs/chart.umd.js"></script>
    }
    <script src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
