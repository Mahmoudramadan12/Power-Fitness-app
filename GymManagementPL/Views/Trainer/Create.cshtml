@model CreateTrainerViewModel
@{ ViewData["Title"] = "Add trainer"; }
<div class="page-header"><div>
    <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Trainers</a></li><li class="breadcrumb-item active">New</li></ol></nav>
    <h1>Add trainer</h1></div></div>

<form asp-action="Create" method="post" novalidate>
    <div class="card form-narrow"><div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" autocomplete="off" /><span asp-validation-for="Name"></span></div>
            <div class="col-md-6"><label asp-for="Specialty" class="form-label"></label><select asp-for="Specialty" class="form-select" asp-items="Html.GetEnumSelectList<Specialties>()"><option value="">Select…</option></select><span asp-validation-for="Specialty"></span></div>
            <div class="col-md-6"><label asp-for="DateOfBirth" class="form-label"></label><input asp-for="DateOfBirth" type="date" class="form-control" /><span asp-validation-for="DateOfBirth"></span></div>
            <div class="col-md-6"><label asp-for="Gender" class="form-label"></label><select asp-for="Gender" class="form-select" asp-items="Html.GetEnumSelectList<Gender>()"><option value="">Select…</option></select><span asp-validation-for="Gender"></span></div>
            <div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" type="email" class="form-control" autocomplete="off" /><span asp-validation-for="Email"></span></div>
            <div class="col-md-6"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" type="tel" inputmode="numeric" maxlength="11" class="form-control" placeholder="01XXXXXXXXX" /><span asp-validation-for="Phone"></span></div>
            <div class="col-md-3"><label asp-for="BuildingNumber" class="form-label"></label><input asp-for="BuildingNumber" type="number" min="1" class="form-control" /><span asp-validation-for="BuildingNumber"></span></div>
            <div class="col-md-5"><label asp-for="Street" class="form-label"></label><input asp-for="Street" class="form-control" /><span asp-validation-for="Street"></span></div>
            <div class="col-md-4"><label asp-for="City" class="form-label"></label><input asp-for="City" class="form-control" /><span asp-validation-for="City"></span></div>
        </div>
    </div>
    <div class="card-footer bg-transparent p-3 d-flex gap-2"><button type="submit" class="btn btn-primary">Save trainer</button><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
