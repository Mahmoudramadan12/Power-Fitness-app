@model TrainerDetailsViewModel
@{ ViewData["Title"] = Model.Name; }
<div class="page-header">
    <div>
        <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Trainers</a></li><li class="breadcrumb-item active">@Model.Name</li></ol></nav>
        <div class="profile-head">
            <partial name="_Avatar" model='new AvatarModel(Model.Name, null, "xl")' />
            <div><h1>@Model.Name</h1><p class="lead mb-2">@Model.Age years old · hired @Model.HireDate.ToString("MMMM yyyy")</p><span class="chip">@Model.SpecialtyName</span></div>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id"><i class="bi bi-pencil"></i> Edit</a>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" data-confirm="Delete @Model.Name? Trainers who have led or are scheduled to lead sessions can't be deleted, to keep session history intact." data-confirm-title="Delete trainer?" data-confirm-ok="Delete trainer">
            <button type="submit" class="btn btn-outline-danger" data-no-loading><i class="bi bi-trash"></i> Delete</button>
        </form>
    </div>
</div>
<div class="row g-3">
    <div class="col-lg-5"><div class="card"><div class="card-header">Details</div><div class="card-body"><dl class="kv">
        <dt>Email</dt><dd class="text-break">@Model.Email</dd><dt>Phone</dt><dd class="tabular">@Model.Phone</dd><dt>Gender</dt><dd>@Model.Gender</dd>
        <dt>Date of birth</dt><dd>@Model.DateOfBirth.ToString("d MMM yyyy")</dd><dt>Address</dt><dd>@Model.Address</dd><dt>Sessions led</dt><dd>@Model.TotalSessions</dd></dl></div></div></div>
    <div class="col-lg-7"><div class="card">
        <div class="card-header">Upcoming sessions</div>
        @if (Model.UpcomingSessions.Count == 0) { <div class="empty"><i class="bi bi-calendar-x"></i><h3>Nothing scheduled</h3></div> }
        else
        {
            <div class="list-group list-group-flush">
            @foreach (var s in Model.UpcomingSessions)
            {
                <a class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3 bg-transparent" asp-controller="Booking" asp-action="Roster" asp-route-id="@s.Id">
                    <div class="date-tile"><b>@s.StartDate.Day</b><span>@s.StartDate.ToString("MMM")</span></div>
                    <div class="flex-grow-1"><div class="fw-semibold">@s.CategoryName</div><div class="small text-muted">@s.StartDate.ToString("ddd h:mm tt") – @s.EndDate.ToString("h:mm tt")</div></div>
                    <span class="small text-muted tabular">@s.BookedCount / @s.Capacity</span>
                </a>
            }
            </div>
        }
    </div></div>
</div>
